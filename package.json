{
  "name": "perfumes-api",
  "version": "2.0.0",
  "description": "Microservicio de catálogo de perfumes con pipeline CI/CD, contenedores y orquestación",
  "main": "src/server.js",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --ci --runInBand",
    "lint": "eslint src/ tests/",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "docker",
    "compose",
    "express",
    "perfumes"
  ],
  "author": "Equipo Perfumes API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
